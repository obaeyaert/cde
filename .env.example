# SMTP OVH — le mot de passe doit être celui régénéré après la migration,
# jamais celui présent dans l'ancienne base WordPress.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=contact@cdegroupe.com
SMTP_PASS=

# Anti-robot Cloudflare Turnstile (optionnel : sans clés, seul le honeypot protège)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
