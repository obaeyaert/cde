---
import { nav, site } from '../data/site';

/* En-tête « fusion-header-v1 » d'Avada : logo 237×76 à gauche, menu à droite sur
   96 px de haut, surlignage blanc au-dessus de la rubrique courante, chevron sur les
   entrées à sous-menu. Aucune autre information (le téléphone est dans le pied de page). */
const { pathname } = Astro.url;
const isActive = (href: string) => pathname === href;
const inBranch = (item: (typeof nav)[number]) =>
  isActive(item.href) || (item.children?.some((c) => isActive(c.href)) ?? false);
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="logo" aria-label={`${site.name} — accueil`}>
      <img src={site.logo} alt={site.name} width="237" height="76" fetchpriority="high" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <label for="nav-toggle" class="burger" aria-label="Ouvrir le menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="main-nav" aria-label="Navigation principale">
      <ul class="level-1">
        {nav.map((item) => (
          <li class:list={[{ 'has-children': !!item.children, 'is-current': inBranch(item) }]}>
            <a href={item.href} aria-current={inBranch(item) ? 'page' : undefined}>
              {item.label}
              {item.children && <span class="chevron" aria-hidden="true"></span>}
            </a>
            {item.children && (
              <ul class="level-2">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} aria-current={isActive(child.href) ? 'page' : undefined}>{child.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Comme l'original : l'en-tête reste fixé en haut au défilement, le menu passe à 14 px. */
  .site-header { background: var(--color-header-bg); position: sticky; top: 0; z-index: 100; }
  .site-header.is-sticky .level-1 > li > a { font-size: 14px; }
  .bar { display: flex; align-items: center; justify-content: space-between; min-height: var(--header-h); padding-inline: 20px; }
  @media (min-width: 1210px) { .bar { padding-inline: 0; } }
  .logo { flex: 0 0 auto; }
  .logo img { width: 237px; height: 76px; }

  .level-1 { display: flex; list-style: none; margin: 0; padding: 0; }
  .level-1 > li { position: relative; }
  .level-1 > li > a {
    position: relative; display: flex; align-items: center; gap: 8px;
    height: 96px; padding: 0 23px; color: #fff; font-size: 16px; line-height: 16px;
    border-top: 3px solid transparent;
  }
  .level-1 > li:last-child > a { padding-right: 0; }
  .level-1 > li > a:hover, .level-1 > li.is-current > a { color: #fff; border-top-color: #fff; }

  .chevron {
    width: 6px; height: 6px; margin-top: -3px;
    border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
  }

  .level-2 {
    position: absolute; top: 100%; left: 0; min-width: 265px; z-index: 10;
    list-style: none; margin: 0; padding: 0; background: var(--color-header-bg);
    opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity .2s ease, transform .2s ease, visibility .2s;
    box-shadow: 0 10px 24px rgb(0 0 0 / 25%);
  }
  .has-children:hover > .level-2, .has-children:focus-within > .level-2 { opacity: 1; visibility: visible; transform: none; }
  .level-2 a {
    display: block; padding: 12px 20px; color: #fff; font-size: 14px; line-height: 20px;
    border-bottom: 1px solid rgb(255 255 255 / 8%);
  }
  .level-2 a:hover, .level-2 a[aria-current] { background: #2b2e35; color: var(--color-primary); }

  .nav-toggle, .burger { display: none; }

  @media (max-width: 1100px) {
    :root { --header-h: 78px; }
    .bar { flex-wrap: wrap; min-height: 78px; }
    .logo img { width: 118.5px; height: 38px; }
    .burger { display: flex; flex-direction: column; gap: 5px; cursor: pointer; padding: 10px; }
    .burger span { display: block; width: 26px; height: 2px; background: #fff; }
    .main-nav { flex-basis: 100%; max-height: 0; overflow: hidden; transition: max-height .28s ease; }
    .nav-toggle:checked ~ .main-nav { max-height: 85vh; overflow-y: auto; }
    .level-1 { flex-direction: column; padding-bottom: 12px; }
    .level-1 > li > a { height: auto; padding: 14px 0; border-top: 0; border-bottom: 1px solid rgb(255 255 255 / 10%); }
    .level-1 > li.is-current > a { color: var(--color-primary); }
    .chevron { display: none; }
    .level-2 { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; padding-left: 16px; min-width: 0; }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const update = () => header?.classList.toggle('is-sticky', window.scrollY > 0);
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>
