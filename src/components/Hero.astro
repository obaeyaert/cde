---
import sizes from '../generated/image-sizes.json';

/**
 * Bandeau plein écran de la page d'accueil.
 * Reprend le Fusion Slider d'Avada (slide « Home ») : image en cover, titre et
 * sous-titre centrés en blanc. Le titre reste un <p> : le H1 de la page appartient
 * au contenu, comme le veut la hiérarchie sémantique.
 */
interface Props {
  image: string;
  title: string;
  subtitle: string;
}

const { image, title, subtitle } = Astro.props;

type ImageEntry = { width: number; height: number; webp: string; srcset: { url: string; width: number }[] };
const entry = (sizes as Record<string, ImageEntry>)[image];
const srcset = entry?.srcset.map((v) => `${v.url} ${v.width}w`).join(', ');
---

<section class="hero">
  <picture>
    <source srcset={srcset} sizes="100vw" type="image/webp" />
    <img
      src={image}
      alt=""
      width={entry?.width}
      height={entry?.height}
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <div class="overlay">
    <p class="title">{title}</p>
    <p class="subtitle">{subtitle}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: clamp(380px, calc(100vh - var(--header-h)), 760px);
    overflow: hidden;
    background: #1c1f24;
  }
  .hero img {
    width: 100%; height: 100%; object-fit: cover;
    /* Le sujet de la photo est dans la moitié basse du cadrage d'origine. */
    object-position: center 60%;
  }
  .overlay {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: .75rem; text-align: center; padding: 1.5rem;
    /* Voile léger : le texte blanc doit rester lisible sur une photo claire. */
    background: linear-gradient(to bottom, rgb(0 0 0 / 12%), rgb(0 0 0 / 32%));
  }
  .title {
    margin: 0; color: #fff; line-height: 1.1;
    font-size: clamp(2.6rem, 6vw, 4.375rem);
    text-shadow: 0 2px 18px rgb(0 0 0 / 35%);
  }
  .subtitle {
    margin: 0; color: #fff; letter-spacing: 2px; line-height: 2.25;
    font-size: clamp(1rem, 1.8vw, 1.5rem);
    text-shadow: 0 2px 14px rgb(0 0 0 / 35%);
  }
</style>
