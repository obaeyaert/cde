---
import sizes from '../generated/image-sizes.json';

/**
 * Bandeau de tête : reprend les Fusion Sliders d'Avada (une diapositive par page).
 * Accueil : plein écran (100vh − 111 px comme l'original), titre 70 px centré.
 * Mentions légales : 400 px, titre 50 px aligné à gauche.
 * Le titre reste un <p> : le H1 de la page appartient au contenu.
 */
interface Props {
  image: string;
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
  height?: 'full' | string;
  titleSize?: string;
  subtitleSize?: string;
  /** 'h1' quand le contenu n'a pas de titre principal (mentions légales), sinon 'p' */
  titleTag?: 'h1' | 'p';
}

const {
  image, title, subtitle, align = 'center', height = 'full', titleSize = '70px', subtitleSize = '24px', titleTag = 'p',
} = Astro.props;
const Title = titleTag;

type ImageEntry = { width: number; height: number; webp: string; srcset: { url: string; width: number }[] };
const entry = (sizes as Record<string, ImageEntry>)[image];
const srcset = entry?.srcset.map((v) => `${v.url} ${v.width}w`).join(', ');
const heightCss = height === 'full' ? 'calc(100vh - 111px)' : height;
---

<section class={`hero align-${align}`} style={`--h:${heightCss};--ts:${titleSize};--ss:${subtitleSize}`}>
  <picture>
    <source srcset={srcset} sizes="100vw" type="image/webp" />
    <img src={image} alt="" width={entry?.width} height={entry?.height} fetchpriority="high" decoding="async" />
  </picture>

  <div class="overlay">
    <div class="inner">
      <Title class="title">{title}</Title>
      {subtitle && <p class="subtitle">{subtitle}</p>}
    </div>
  </div>
</section>

<style>
  .hero { position: relative; height: var(--h); min-height: 320px; overflow: hidden; background: #1c1f24; }
  .hero img { width: 100%; height: 100%; object-fit: cover; object-position: center 60%; }
  .overlay {
    position: absolute; inset: 0; display: flex; align-items: center;
    /* Voile léger : le texte blanc doit rester lisible sur une photo claire. */
    background: linear-gradient(to bottom, rgb(0 0 0 / 12%), rgb(0 0 0 / 32%));
  }
  .inner { width: 100%; max-width: var(--site-max); margin-inline: auto; padding-inline: 20px; }
  @media (min-width: 1210px) { .inner { padding-inline: 0; } }
  .align-center .inner { text-align: center; }
  .align-left .inner { text-align: left; }

  .title { margin: 0; color: #fff; font-weight: 400; line-height: 1.2; font-size: var(--ts); text-shadow: 0 2px 18px rgb(0 0 0 / 35%); }
  .subtitle { margin: 0; color: #fff; letter-spacing: 2px; line-height: 36px; font-size: var(--ss); text-shadow: 0 2px 14px rgb(0 0 0 / 35%); }

  @media (max-width: 900px) {
    .title { font-size: clamp(2.2rem, 9vw, var(--ts)); }
    .subtitle { font-size: clamp(1rem, 4vw, var(--ss)); }
  }
</style>
