---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import brands from '../../generated/brands.json';
import sizes from '../../generated/image-sizes.json';

/* Page traitée à part : les 68 logos forment une grille, ce que le Markdown issu du
   page-builder ne sait pas exprimer. Les métadonnées restent celles de la collection. */
const entry = await getEntry('pages', 'marques-partenaires');
const d = entry!.data;

const [header, ...sections] = brands as {
  heading: string;
  intro: string | null;
  lead: string | null;
  brands: { name: string; url: string | null; logo: string; group: string | null }[];
}[];

type ImageEntry = { width: number; height: number; webp: string; srcset: { url: string; width: number }[] };
const image = (logo: string): ImageEntry | undefined => (sizes as Record<string, ImageEntry>)[logo];
/* Les vignettes font au plus 200px de large dans la grille. */
const LOGO_SIZES = '200px';

/* Les marques sont regroupées par intertitre, en préservant l'ordre d'origine. */
const grouped = (list: (typeof sections)[number]['brands']) => {
  const out: { group: string | null; items: typeof list }[] = [];
  for (const brand of list) {
    const last = out.at(-1);
    if (last && last.group === brand.group) last.items.push(brand);
    else out.push({ group: brand.group, items: [brand] });
  }
  return out;
};

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: d.title, url: '/marques-partenaires/' },
];
---

<Base
  metaTitle={d.metaTitle}
  description={d.description}
  canonical={d.canonical}
  ogImage={d.ogImage}
  breadcrumbs={breadcrumbs}
>
  <nav class="breadcrumb" aria-label="Fil d'ariane">
    <div class="container">
      <ol>
        <li><a href="/">Accueil</a></li>
        <li><span aria-current="page">{d.title}</span></li>
      </ol>
    </div>
  </nav>

  <div class="container intro">
    <h1>{header.heading}</h1>
    {header.intro && <p class="lead">{header.intro}</p>}
    {header.lead && <p class="lead">{header.lead}</p>}
  </div>

  {sections.map((section) => (
    <section class="brand-section">
      <div class="container">
        <h2>{section.heading}</h2>
        {section.intro && <p class="lead">{section.intro}</p>}
        {section.lead && section.lead !== section.intro && <p class="lead">{section.lead}</p>}

        {grouped(section.brands).map(({ group, items }) => (
          <div class="group">
            {group && <h3>{group}</h3>}
            <ul class="grid">
              {items.map((brand) => {
                const entry = image(brand.logo);
                const logo = (
                  <picture>
                    <source
                      srcset={entry?.srcset.map((v) => `${v.url} ${v.width}w`).join(', ')}
                      sizes={LOGO_SIZES}
                      type="image/webp"
                    />
                    <img
                      src={brand.logo}
                      alt={brand.name}
                      width={entry?.width}
                      height={entry?.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                );
                return (
                  <li>
                    {brand.url ? (
                      <a href={brand.url} target="_blank" rel="noopener noreferrer nofollow">
                        {logo}
                        <span>{brand.name}</span>
                      </a>
                    ) : (
                      <div class="static">{logo}<span>{brand.name}</span></div>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>
  ))}
</Base>

<style>
  .breadcrumb { background: var(--color-surface); border-bottom: 1px solid var(--color-border); font-size: 13px; }
  .breadcrumb ol { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; margin: 0; padding: .85rem 0; }
  .breadcrumb li + li::before { content: '\203A'; margin-right: .5rem; color: #9aa0a6; }
  .breadcrumb [aria-current] { color: var(--color-heading); }

  .intro { padding-block: 3rem 1rem; }
  .lead { max-width: 68ch; }

  .brand-section { padding-block: 2.5rem; }
  .brand-section:nth-of-type(even) { background: var(--color-surface); }
  .brand-section h2 { margin-bottom: .5rem; }
  .brand-section h3 {
    font-size: 1rem; text-transform: uppercase; letter-spacing: .08em;
    color: var(--color-primary); margin: 2.25rem 0 1rem;
    padding-bottom: .5rem; border-bottom: 1px solid var(--color-border);
  }

  .grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1.5rem; list-style: none; margin: 0; padding: 0;
  }
  .grid li { margin: 0; }
  .grid a, .grid .static {
    display: flex; flex-direction: column; align-items: center; gap: .6rem;
    height: 100%; padding: 1.1rem; background: #fff;
    border: 1px solid var(--color-border); border-radius: 3px;
    text-align: center; color: var(--color-text); text-decoration: none;
    transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
  }
  .grid a:hover {
    border-color: var(--color-primary); text-decoration: none;
    box-shadow: 0 6px 18px rgb(36 41 48 / 10%); transform: translateY(-2px);
  }
  .grid picture { display: block; width: 100%; }
  .grid img {
    width: 100%; height: 84px; object-fit: contain;
    filter: grayscale(1); opacity: .78; transition: filter .2s ease, opacity .2s ease;
  }
  .grid a:hover img { filter: none; opacity: 1; }
  .grid span { font-size: 13px; line-height: 1.35; }
</style>
